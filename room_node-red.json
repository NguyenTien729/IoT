    {
        "id": "0fa6a6817dfc822e",
        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "cảnh báo nhiệt độ",
        "func": "const temp = Number(msg.payload?.temp);\n\nif (!Number.isFinite(temp)) return null;\n\nconst wasHot = context.get(\"wasHot\") === true;\n\n// Khi nhiệt độ vừa đạt ngưỡng, bật còi một lần\nif (temp >= 45 && !wasHot) {\n    context.set(\"wasHot\", true);\n\n    return {\n        topic: \"nhom20/phong1/cmd\",\n        payload: \"buzzer_on\"\n    };\n}\n\n// Cho phép cảnh báo lại sau khi nhiệt độ giảm\nif (temp < 40) {\n    context.set(\"wasHot\", false);\n}\n\nreturn null;",
