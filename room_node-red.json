    {
        "id": "7c93baf37de23262",
        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "Trạng thái an ninh",
        "func": "const d = msg.payload;\nif (!d || typeof d.armed !== \"boolean\") return null;   // ESP32 bản cũ chưa gửi trường armed\nconst alarm = d.alarm || \"none\";\n\nnode.status({\n    fill: alarm !== \"none\" ? \"red\" : (d.armed ? \"green\" : \"grey\"),\n    shape: \"dot\",\n    text: (d.armed ? \"An ninh BẬT\" : \"An ninh TẮT\") + (alarm !== \"none\" ? \" | BÁO ĐỘNG: \" + alarm : \"\")\n});\n\n// Lưu để node khác (dashboard, web) dùng: flow.get(\"armed\"), flow.get(\"alarm\")\nconst changed = flow.get(\"armed\") !== d.armed || flow.get(\"alarm\") !== alarm;\nflow.set(\"armed\", d.armed);\nflow.set(\"alarm\", alarm);\nif (!changed) return null;              // chỉ đi tiếp khi trạng thái thay đổi\nmsg.payload = { armed: d.armed, alarm: alarm };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 420,
        "wires": [["a75472a516239117"]]
    },
