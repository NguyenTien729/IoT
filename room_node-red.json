    {
        "id": "3d76926015f70acd",
        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "ntfy | Nhắc lại mỗi 20 giây nếu còn cảnh báo",
        "func": "const a = msg.alert;\nif (!a || !a.key) return null;\n// Chi gioi han tan suat 20 giay cho cung loai canh bao;\n// neu con cua mo/co nguoi, sensor 2 giay se tiep tuc kich hoat.\nconst now = Date.now();\nconst key = \"ntfy_last_\" + a.key;\nconst last = flow.get(key) || 0;\nif (a.key !== \"test\" && now - last < 20000) return null;\nflow.set(key,now);\nmsg.alertText = a.body + \" | Luc: \" + new Date().toLocaleString(\"vi-VN\",{timeZone:\"Asia/Ho_Chi_Minh\"});\nmsg.method = \"GET\";\nmsg.url = \"http://172.20.10.4/capture\";\nmsg.headers = {};\nmsg.payload = \"\";\nreturn msg;",
