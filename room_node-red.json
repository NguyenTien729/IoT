        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "ntfy | Ảnh hay chỉ chữ?",
        "func": "const p = msg.payload;\nconst ok = msg.statusCode === 200 && Buffer.isBuffer(p) && p.length > 100 && p[0] === 0xFF && p[1] === 0xD8;\nif (ok) {\n  msg.method = \"PUT\";\n  msg.url = \"https://ntfy.sh/iot-room-security-nhom20\";\n  msg.headers = {\n    \"Content-Type\":\"image/jpeg\",\n    \"Filename\":\"canh-bao-esp32.jpg\",\n    \"Title\":String(msg.alert.title || \"Canh bao Nhom 20\").replace(/[^\\x20-\\x7E]/g, \" \"),\n    \"Message\":String(msg.alertText || \"\").replace(/[^\\x20-\\x7E]/g, \" \"),\n    \"Priority\":\"5\",\n    \"Tags\":\"warning,camera\"\n  };\n  return [msg,null];\n}\nmsg.cameraError = \"Camera khong tra ve anh JPEG (HTTP \" + msg.statusCode + \")\";\nreturn [null,msg];",
        "outputs": 2,
        "x": 1550,
