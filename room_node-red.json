    {
        "id": "6fffef495852ce2d",
        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "xử lý dữ liệu",
        "func": "\nconst d = msg.payload;\n\nif (!d || typeof d !== \"object\") return null;\n\nconst fields = {};\n\nfor (const key of [\n    \"temp\", \"pressure\", \"lux\",\n    \"gas_mv\", \"gas_rise\", \"sound\", \"rssi\"\n]) {\n    if (typeof d[key] === \"number\" && Number.isFinite(d[key])) {\n        fields[key] = d[key];\n    }\n}\n\nfor (const key of [\"motion\", \"door_open\", \"gas_alarm\", \"armed\"]) {\n    if (typeof d[key] === \"boolean\") {\n        fields[key] = d[key];\n    }\n}\n\nif (typeof d.alarm === \"string\") fields.alarm = d.alarm;\n\nif (Object.keys(fields).length === 0) return null;\n\n// Dùng cho node influxdb out\nmsg.measurement = \"an_ninh_phong\";\nmsg.payload = [\n    fields,\n    { device: \"esp32\", room: \"phong1\" }\n];\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 230,
        "y": 340,
        "wires": [["cad5554311b809ff"]]
    },
