    {
        "id": "985682d4578add76",
        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "Tách từng giá trị",
        "func": "const d = msg.payload;\nconst keys = [\"temp\", \"pressure\", \"lux\", \"gas_rise\", \"sound\", \"motion\", \"door_open\"];\n// mỗi đầu ra là một giá trị, msg.topic = tên trường (dùng cho biểu đồ / InfluxDB sau này)\nreturn keys.map(k => (d[k] === undefined ? null : { topic: k, payload: d[k] }));",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
