    {
        "id": "8e29ee35ee56fbe8",
        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "ntfy | Lọc sự kiện",
        "func": "const d = msg.payload;\nif (!d || typeof d !== \"object\") return null;\nconst type = String(d.type || \"\").toLowerCase();\nconst detail = String(d.detail || \"\").toLowerCase().trim();\nconst armed = typeof d.armed === \"boolean\" ? d.armed : flow.get(\"armed\") === true;\n// Khong gui su kien ket thuc/da xu ly.\nif (type === \"gas\") {\n  if (detail === \"off\" || detail === \"end\" || detail === \"stopped\") return null;\n  msg.alert = {key:\"gas\",title:\"CANH BAO KHI GAS\",body:\"ESP32 phat hien khi gas\"};\n} else if (type === \"alarm\") {\n  if ([\"none\",\"off\",\"false\",\"0\",\"clear\",\"stop\",\"stopped\"].includes(detail)) return null;\n  if (detail.includes(\"gas\")) msg.alert = {key:\"gas\",title:\"CANH BAO KHI GAS\",body:\"ESP32 kich hoat bao dong gas\"};\n  else if (armed) msg.alert = {key:\"intrusion\",title:\"BAO DONG XAM NHAP\",body:\"ESP32 kich hoat bao dong: \" + detail};\n  else return null;\n} else if (armed && type === \"door\" && (detail === \"open\" || d.door_open === true)) {\n  msg.alert = {key:\"intrusion\",title:\"CANH BAO CUA MO\",body:\"Cua phong dang mo khi ARM\"};\n} else if (armed && type === \"motion\" && detail !== \"end\" && detail !== \"off\" && d.motion !== false) {\n  msg.alert = {key:\"intrusion\",title:\"CANH BAO CO NGUOI\",body:\"Phat hien chuyen dong khi ARM: \" + (d.detail || \"\")};\n} else return null;\nreturn msg;",
        "outputs": 1,
        "x": 850,
        "y": 500,
        "wires": [["3d76926015f70acd"]]
    },
    {
        "id": "5f3f32c311ac49f9",
        "type": "function",
        "z": "3c5a91a80d92dd1d",
        "name": "ntfy | Nhiệt độ & gas",
        "func": "const d = msg.payload;\nif (!d || typeof d !== \"object\") return null;\nconst alerts = [];\n// Lay armed truc tiep tu sensor moi 2 giay (khong phu thuoc event).\nif (typeof d.armed === \"boolean\") flow.set(\"armed\", d.armed);\nconst armed = d.armed === true;\nconst intrusion = armed && (d.door_open === true || d.motion === true || d.alarm === \"intrusion\");\nif (intrusion) {\n  const parts = [];\n  if (d.door_open === true) parts.push(\"cua dang mo\");\n  if (d.motion === true) parts.push(\"co nguoi/chuyen dong\");\n  if (!parts.length) parts.push(\"bao dong xam nhap\");\n  alerts.push({key:\"intrusion\",title:\"CANH BAO XAM NHAP\",body:\"ARM: \" + parts.join(\"; \")});\n}\n// Gas: lay trung binh 20 mau gas_mv dau tien.\nconst gas = Number(d.gas_mv);\nlet baseline = flow.get(\"ntfy_gas_baseline\");\nif (d.gas_mv !== undefined && Number.isFinite(gas) && gas >= 0) {\n  if (!Number.isFinite(baseline)) {\n    let samples = flow.get(\"ntfy_gas_samples\") || [];\n    if (samples.length < 20) {\n      samples.push(gas);\n      flow.set(\"ntfy_gas_samples\", samples);\n      if (samples.length === 20) {\n        baseline = samples.reduce((sum,v) => sum + v,0)/20;\n        flow.set(\"ntfy_gas_baseline\",baseline);\n      }\n    }\n  } else if (gas > baseline + 500) {\n    alerts.push({key:\"gas\",title:\"CANH BAO KHI GAS\",body:\"Gas \" + gas.toFixed(0) + \" mV, nen \" + baseline.toFixed(0) + \" mV\"});\n  }\n}\nconst temp = Number(d.temp);\nif (d.temp !== undefined && Number.isFinite(temp) && temp >= 38) {\n  alerts.push({key:\"temp\",title:\"CANH BAO NHIET DO CAO\",body:\"Nhiet do: \" + temp.toFixed(1) + \" do C (nguong 38)\"});\n}\nif (!alerts.length) return null;\nreturn [alerts.map(alert => ({alert}))];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
